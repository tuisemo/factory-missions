{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$FACTORY_PROJECT_DIR/.factory/hooks/load-mission-state.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$FACTORY_PROJECT_DIR/.factory/hooks/enforce-mission-completion.sh\" || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "backbone|branch|validator",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"level\": \"INFO\", \"source\": \"$DROID\", \"message\": \"Subagent $DROID started\"}' | bash \"$FACTORY_PROJECT_DIR/.factory/hooks/log-mission-event-enhanced.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "backbone|branch|validator",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$FACTORY_PROJECT_DIR/.factory/hooks/enforce-mission-completion.sh\" && bash \"$FACTORY_PROJECT_DIR/.factory/hooks/save-mission-state-enhanced.sh\"' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Create",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$FACTORY_PROJECT_DIR/.factory/hooks/format-output.sh\""
          },
          {
            "type": "command",
            "command": "echo '{\"level\": \"DEBUG\", \"source\": \"file_operation\", \"message\": \"File edited/created\", \"extra_info\": \"'$TOOL_INPUT_FILE_PATH'\"}' | bash \"$FACTORY_PROJECT_DIR/.factory/hooks/log-mission-event-enhanced.sh\""
          }
        ]
      },
      {
        "matcher": "Execute|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"level\": \"DEBUG\", \"source\": \"command_execution\", \"message\": \"Command executed\"}' | bash \"$FACTORY_PROJECT_DIR/.factory/hooks/log-mission-event-enhanced.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": []
      }
    ]
  }
}
